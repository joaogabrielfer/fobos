import std::core::*

fun foo(x: Int, y: Int): Int =
	 return x + y
end

fun foo(x: Int): Int =
	return x + 1
end

fun main(): () =
	var my_array := [0]
	echo("my array = " <> my_array)

	my_array.push(1)
	echo("push(1) = " <> my_array)

	my_array.push(2)
	echo("push(2) = " <> my_array)

	let double := x -> x * 2

	// my_array = my_array.map(double)
	map(my_array, double)
	echo("map(double) = " <> my_array)

	echo("foo(5) = " <> foo(5))
	echo("foo(6, 7) = " <> foo(6, 7))

end
