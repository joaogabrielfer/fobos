// end else do
// 	return fib(n - 1) + fib(n - 2)
// end

fun fib(n: Int): Int =
	if n < 2 do
		return n
	end else do
		return fib(n - 1) + fib(n - 2)
	end
end


var i := 1
while i <= 15 do
	echo("fib [" <> i <> "] = " <> fib(i))
	i = i + 1
end

end
