var nums := [1, 2]
push(nums, 3)
push(nums, 4)

echo("nums: " <> nums)

var nested := [[1], [2]]
push(nested[0], 99)

echo("nested: " <> nested)

var values := []
push(values, 10)
push(values, "hello")
push(values, true)

echo("values: " <> values)

