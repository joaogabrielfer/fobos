Ok(
    Program {
        statements: [
            Bind {
                mutable: false,
                name: "foo",
                type_annotation: Inferred,
                value: Int(
                    10,
                ),
            },
            Bind {
                mutable: true,
                name: "bar",
                type_annotation: Explicit(
                    Named(
                        "String",
                    ),
                ),
                value: String(
                    "baz",
                ),
            },
            Bind {
                mutable: false,
                name: "baz",
                type_annotation: Inferred,
                value: Bool(
                    true,
                ),
            },
        ],
    },
)