fun add(x: Int, y: Int): Int =
    return x + y
end

fun answer(): Int =
    return 10
end

fun identity(x: Int): Int =
    return x
end

fun greet(): String =
    return "hello"
end

fun unit_value(): () =
    return ()
end

fun inferred_return(x: Int) :=
    return x + 1
end

echo(add(10, 20))
echo(answer())
echo(identity(7))
echo(greet())
echo(unit_value())
echo(inferred_return(9))
