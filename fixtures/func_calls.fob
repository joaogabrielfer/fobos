fun main(): () =
fun add(x: Int, y: Int): Int =
    return x + y
end

fun double(value: Int): Int =
    return value * 2
end

let first := add(1, 2)
let second := add(1 + 2, 3 * 4)
let nested := double(add(1, 2))
let arithmetic := add(1, 2) * 3

echo("first: " <> first)
echo("second: " <> second)
echo("nested: " <> nested)
echo("arithmetic: " <> arithmetic)

end
