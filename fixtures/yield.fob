let sum := do
    let left := 10
    let right := 20
    yield left + right
end

let selected := if true do
    yield "yes"
end else do
    yield "no"
end

var i := 0
let first_even := while i < 10 do
    if i == 4 do
        yield i
    end
    i = i + 1
end

echo("sum: " <> sum)
echo("selected: " <> selected)
echo("first_even: " <> first_even)
