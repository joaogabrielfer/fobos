let f :=
    var i := 0

    let foo := while i < 10 do
        if i == 4 do
            yield i
        end

        i = i + 1
    end

	yield foo

    yield 999
end

let g :=
    let inner :=
        let a := 5
        yield a * 2
    end

    yield inner + 1
end

var i := 0
let foo := while i < 10 do
	if i == 4 do
		yield i
	end

