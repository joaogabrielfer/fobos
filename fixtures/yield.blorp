let a :=
	let foo := 1
	let bar := 2
	yield foo + bar
end


let b := do
	yield 6
	yield 5
end

let c := // this one has value of 20, but i think it is the expected result, since it doesnt have implicit returns
    if true do
        yield 10
    end

    yield 20
end


let d :=
    yield if true do // we have to do something like this to 'capture' the result of the if expression and bubble it up
        yield 10
    end

    yield 20
end

let e := if true 10 else do 20 // this works fine
// let e := if true do yield 10 else do 20 // this too

let f :=
    var i := 0

    while i < 10 do
        if i == 3 do
            yield i // this yield does not return from the statement, instead 'e' has value of 999
        end

        i = i + 1
    end


    // yield while i < 10 do // parsing error: while is not an expression
    //     if i == 3 do
    //         yield i
    //     end
    //
    //     i = i + 1
    // end

    yield 999
end

let g :=
    let inner :=
        let a := 5
        yield a * 2
    end

    yield inner + 1
end

return e
