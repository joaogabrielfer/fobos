let a :=
	let foo := 1
	let bar := 2
	yield foo + bar
end


let b := do
	yield 6
	yield 5
end

let c :=
    let foo := if true do
        yield 10
    end

	if true do
		yield 15
	end

	yield foo
	yield 20
end


let d :=
    if true do
        yield 10
    end

    yield 20
