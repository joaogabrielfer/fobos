let add := (x, y) -> do
	return x + y
end
let add_result := add(10, 20)

let inc := x -> x + 1

let make_adder := x -> y -> x + y
let label := x -> if x > 10 "big" else "small"

let calc := (x, y) -> do
    let doubled := x * 2
    return doubled + y
end

echo("add: " <> add_result)
echo("inc: " <> inc(4))
echo("closure: " <> make_adder(10)(5))
echo("label: " <> label(20))
echo("calc: " <> calc(10, 5))
